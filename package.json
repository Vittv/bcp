{
  "name": "bcp",
  "description": "The Book of Common Prayer (1979, The Episcopal Church) Daily Office. Lightweight Expo + React PWA.",
  "author": "Vittorius",
  "license": "MIT",
  "version": "0.1.0",
  "main": "index.ts",
  "private": true,
  "trustedDependencies": [
    "electron",
    "electron-builder"
  ],
  "dependencies": {
    "@expo/metro-runtime": "~57.0.9",
    "expo": "~57.0.12",
    "expo-asset": "^57.0.10",
    "expo-font": "^57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "^5.9.1",
    "react-native-web": "^0.21.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@oxlint/plugins": "1.78.0",
    "@types/node": "^22.10.0",
    "@types/react": "~19.2.2",
    "bun-types": "^1.3.14",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-updater": "^6.3.9",
    "oxlint": "1.78.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export -p web",
    "test": "bun test src/",
    "check": "biome check . && oxlint",
    "format": "biome format --write .",
    "version": "bun scripts/bump-version.ts",
    "desktop:export": "BASE_URL=/ expo export -p web",
    "desktop:eject": "bun scripts/build-electron.ts",
    "desktop:dev": "bun run desktop:export && bun run desktop:eject && electron dist-electron/main.js --dev",
    "desktop:build": "bun run desktop:export && bun run desktop:eject && electron-builder --config build.json"
  }
}
