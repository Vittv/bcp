{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default core access plus the window operations the custom titlebar needs (drag, minimize, maximize toggle, close, decoration and title bar style switching).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-set-decorations",
    "core:window:allow-set-title-bar-style",
    "process:default",
    "updater:default"
  ]
}
